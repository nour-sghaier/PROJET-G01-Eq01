rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Toutes les lectures/écritures passent par le backend (Firebase Admin SDK,
    // qui ignore ces règles) : l'accès direct depuis le web/mobile est interdit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
