PORT=3000
# Chemin du fichier de clé du compte de service Firebase (jamais commité)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Origine autorisée (CORS) : l'application web
WEB_ORIGIN=http://localhost:3001

# Konnect (mode test / sandbox)
KONNECT_API_URL=
KONNECT_API_KEY=
KONNECT_WALLET_ID=
# URL publique appelée par Konnect après paiement (ex. https://xxxx.ngrok.app/api/payments/webhook)
KONNECT_WEBHOOK_URL=
