PORT=3000
# Chemin du fichier de clé du compte de service Firebase (jamais commité)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Origine autorisée (CORS) : l'application web (Vite = 5173)
WEB_ORIGIN=http://localhost:5173

# --- Paiement ---
# Sans clé Konnect, l'API utilise un paiement de DÉMONSTRATION (page "Confirmer le paiement").
# Adresse du backend vue depuis l'appareil qui ouvre le lien de paiement :
#   émulateur Android : http://10.0.2.2:3000   |   téléphone réel : http://IP_DU_PC:3000
PUBLIC_URL=http://10.0.2.2:3000

# Konnect (mode test / sandbox) : à remplir seulement si vous avez un compte Konnect
KONNECT_API_URL=https://api.sandbox.konnect.network/api/v2
KONNECT_API_KEY=
KONNECT_WALLET_ID=
# Facultatif : le backend interroge aussi Konnect quand l'étudiant rafraîchit sa commande,
# donc ngrok n'est pas obligatoire. Exemple : https://xxxx.ngrok.app/api/payments/webhook
KONNECT_WEBHOOK_URL=
